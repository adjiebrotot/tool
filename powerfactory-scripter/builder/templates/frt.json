            "var": "m:u1",
            "combine": "none"
          },
          {
            "id": "r2",
            "el": {
              "cls": "ElmGenstat",
              "name": "",
              "match": "one"
            },
            "var": "m:P:bus1",
            "combine": "none"
          }
        ],
        "caseEvents": "auto",
        "fast": false,
        "extendTo": 0,
        "ufls": null
      },
      "pin": [],
      "sv": 1
    },
    {
