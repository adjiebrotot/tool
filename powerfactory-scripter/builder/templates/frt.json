    {
      "id": "n2",
      "type": "note",
      "x": 0,
      "y": -300,
      "label": "About this template",
      "s": {
        "text": "This applies a 150 ms three-phase fault at the connection point busbar, runs an RMS simulation and checks the busbar voltage against an LVRT curve that starts at the clearing time (an example: type your grid code's points on LVRT curve). It also checks that the plant active power is back to 90 % of its pre-fault value, and stays there for 0.5 s, within 1 s of clearing; a run that stops early (loss of synchronism) still gets its row, with the curves it reached. Fill in the project, the busbar and the two Record rows on Run RMS simulation."
      },
      "pin": [],
      "sv": 1
    },
    {
      "id": "n3",
      "type": "pf.evt.shc",
      "x": 320,
      "y": 0,
      "label": "Connection point fault",
      "s": {
        "target": {
          "cls": "ElmTerm",
          "name": "",
          "match": "one"
        },
        "t": 1,
        "duration": 0.15,
        "fault": "3ph",
        "phase1": "a",
        "phase2": "ab",
        "clear": "fault",
        "rf": 0,
        "xf": 0,
        "loc": null
      },
      "pin": [
        "target"
      ],
      "sv": 1
    },
    {
      "id": "n4",
      "type": "pf.rms",
      "x": 640,
      "y": 0,
      "label": "",
