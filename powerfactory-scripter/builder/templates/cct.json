            "high": ""
          },
          {
            "id": "k4",
            "x": 1.5,
            "low": 0.9,
            "high": ""
          }
        ],
        "x0": 0,
        "extend": false,
        "after": null,
        "before": null,
        "goOn": true
      },
      "pin": [
        "hi"
      ],
      "sv": 1
    },
    {
