        "lo": null,
        "hi": 180,
        "curve": [
          {
            "id": "k1",
            "x": 0,
            "low": 0,
            "high": ""
          },
          {
            "id": "k2",
            "x": 0.15,
            "low": 0,
            "high": ""
          },
          {
            "id": "k3",
            "x": 0.15,
