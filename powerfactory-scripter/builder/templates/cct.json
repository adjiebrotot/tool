    {
      "id": "n2",
      "type": "note",
      "x": 0,
      "y": -300,
      "label": "About this template",
      "s": {
        "text": "This searches the longest three-phase fault at a busbar that the system survives: each try applies the fault for the duration tried, runs an RMS simulation and checks that the rotor angle spread of all synchronous generators stays below the limit (180 degrees). Find limit reads the angle check at the end of each try; a simulation that stops early reports a fail (unstable). Fill in the project and the faulted busbar."
      },
      "pin": [],
      "sv": 1
    },
    {
      "id": "n3",
      "type": "opt.limit",
      "x": 320,
      "y": 0,
      "label": "Fault duration (s)",
      "s": {
        "name": "",
        "lower": 0.05,
        "upper": 0.5,
        "tol": 0.01,
        "maxSteps": 12,
        "passes": "low",
        "bracket": "given",
        "onUnknown": "stop",
        "integer": false,
        "passIs": "yes"
      },
      "pin": [
        "lower",
        "upper",
        "tol"
      ],
      "sv": 1
    },
    {
      "id": "n4",
      "type": "pf.evt.shc",
      "x": 640,
      "y": 0,
      "label": "Fault",
      "s": {
        "target": {
          "cls": "ElmTerm",
          "name": "",
          "match": "one"
        },
        "t": 1,
        "duration": 0.1,
        "fault": "3ph",
        "phase1": "a",
        "phase2": "ab",
        "clear": "fault",
        "rf": 0,
        "xf": 0,
        "loc": null
      },
      "pin": [
        "target"
      ],
      "sv": 1
    },
    {
      "id": "n5",
      "type": "pf.rms",
      "x": 960,
      "y": 0,
      "label": "",
      "s": {
        "tstop": 5,
        "tstart": null,
        "step": null,
        "net": "case",
        "record": [
          {
            "id": "r1",
            "el": {
              "cls": "ElmSym",
              "name": "*",
              "match": "all"
            },
            "var": "c:firel",
            "combine": "spread"
          }
        ],
        "caseEvents": "auto",
        "fast": false,
        "extendTo": 0,
        "ufls": null
      },
      "pin": [],
      "sv": 1
    },
    {
      "id": "n6",
      "type": "chk.limit",
      "x": 1280,
      "y": 0,
      "label": "Rotor angle spread (deg)",
      "s": {
