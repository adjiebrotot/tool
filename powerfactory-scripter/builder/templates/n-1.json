      "s": {
        "name": "",
        "lines": true,
        "trafos": true,
        "gens": false,
        "xnets": false,
        "query": "",
        "order": "1",
        "inService": true,
        "how": "outserv",
        "t": 1,
        "base": true,
        "restore": "pass",
        "onError": "skip"
      },
      "pin": [],
      "sv": 2
    },
    {
