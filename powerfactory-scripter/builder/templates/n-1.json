        "text": "Worst outage: {worst}, with a line loaded to {loading:.1f} %",
        "level": "info"
      },
      "pin": [],
      "sv": 1
    },
    {
      "id": "n12",
      "type": "out.table.column",
      "x": 960,
      "y": 930,
      "label": "Worst outage",
      "s": {
