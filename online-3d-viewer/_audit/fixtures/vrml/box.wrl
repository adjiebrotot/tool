#VRML V2.0 utf8
# a box, and a sky that must not count toward the size
Background { skyColor [ 0.2 0.3 0.6 ] }
Transform { children [ Shape {
 appearance Appearance { material Material { diffuseColor 0.8 0.1 0.1 } }
 geometry IndexedFaceSet {
  solid FALSE
  coord Coordinate { point [ 0 0 0, 30 0 0, 30 20 0, 0 20 0, 0 0 10, 30 0 10, 30 20 10, 0 20 10 ] }
  coordIndex [ 0 3 2 1 -1, 4 5 6 7 -1, 0 1 5 4 -1, 2 3 7 6 -1, 3 0 4 7 -1, 1 2 6 5 -1 ]
 }
} ] }
